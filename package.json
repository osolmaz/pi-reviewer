{
  "name": "@osolmaz/pi-reviewer",
  "version": "0.2.0",
  "description": "Standalone Pi code reviewer with Codex-compatible findings",
  "keywords": [
    "pi-package",
    "pi",
    "code-review",
    "cli"
  ],
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/osolmaz/pi-reviewer"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "bin": {
    "pi-reviewer": "dist/src/cli.js"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist/src/**",
    "reviewer/**",
    "pi-factory.toml",
    "README.md",
    "docs/CODEX-COMPARISON.md",
    "docs/CASE-STUDY.md",
    "docs/UPSTREAM.md",
    "LICENSE",
    "LICENSE.codex"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node scripts/chmod-bin.ts",
    "format": "prettier --check .",
    "lint": "eslint . --config eslint.config.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run --config vitest.config.ts",
    "coverage": "vitest run --coverage --config vitest.config.ts",
    "dry": "slophammer-ts dry .",
    "mutate": "stryker run stryker.config.mjs",
    "slophammer": "sh scripts/run-slophammer.sh",
    "check": "npm run format && npm run lint && npm run typecheck && npm run test && npm run coverage && npm run build && npm run dry",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@earendil-works/pi-ai": "0.84.2",
    "@earendil-works/pi-coding-agent": "0.84.2",
    "@osolmaz/pi-factory": "0.6.0",
    "jiti": "^2.7.0",
    "pi-huggingface-oauth": "0.2.0",
    "typebox": "1.3.9"
  },
  "devDependencies": {
    "@eslint/js": "9.39.2",
    "@stryker-mutator/core": "9.6.1",
    "@stryker-mutator/typescript-checker": "9.6.1",
    "@stryker-mutator/vitest-runner": "9.6.1",
    "@types/node": "22.19.11",
    "@vitest/coverage-v8": "3.2.7",
    "eslint": "9.39.2",
    "prettier": "3.8.1",
    "slophammer-ts": "0.4.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.53.1",
    "vitest": "3.2.7"
  },
  "overrides": {
    "qs": "6.15.3"
  }
}
